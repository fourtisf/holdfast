# Caddy: automatic HTTPS (Let's Encrypt) in front of the whole stack on one domain, so only the
# site's own DNS records are needed. SITE_DOMAIN comes from .env.
#   https://<site>/            web
#   https://<site>/api/...     api (REST, /api/ws WebSocket, /api/metadata), prefix stripped
#   https://<site>/webhooks/   indexer (Helius raw webhooks: /webhooks/helius)

{$SITE_DOMAIN} {
	encode zstd gzip

	handle_path /api/* {
		# Prometheus metrics stay private: scrape them inside the compose network (api:4000/metrics).
		@metrics path /metrics
		respond @metrics 404
		reverse_proxy api:4000 {
			# The Telegram bot's per-user rate-limit headers (INTERNAL_API_TOKEN) only count from inside the compose network.
			header_up -X-Moatpad-Internal-Token
			header_up -X-Moatpad-Telegram-User
		}
	}
	handle /webhooks/* {
		reverse_proxy indexer:4100
	}
	handle {
		reverse_proxy web:3000
	}
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}
