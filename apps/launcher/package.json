{
  "name": "@holdfast/launcher",
  "version": "0.1.0",
  "private": true,
  "description": "Launch flow worker: watches deposit addresses, creates the pump.fun coin with creator = Holdfast treasury PDA, registers the vault, executes the dev buy and refunds the rest.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "cost": "tsx src/cli/cost.ts"
  },
  "dependencies": {
    "@holdfast/chain": "workspace:*",
    "@holdfast/core": "workspace:*",
    "@holdfast/db": "workspace:*",
    "@pump-fun/pump-sdk": "4.1.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "bn.js": "^5.2.2",
    "bs58": "^6.0.0",
    "pino": "^10.1.0"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "0.31.1",
    "@types/bn.js": "^5.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
