{
  "name": "@holdfast/web",
  "version": "0.1.0",
  "private": true,
  "description": "Holdfast launchpad frontend (Next.js App Router).",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "dev:mock": "NEXT_PUBLIC_USE_MOCKS=1 next dev --port 3000",
