{
  "name": "@holdfast/indexer",
  "version": "0.1.0",
  "private": true,
  "description": "Indexes pump.fun / PumpSwap trades and Holdfast vault events for Holdfast mints into Postgres.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts"
  },
  "dependencies": {
    "@holdfast/chain": "workspace:*",
    "@holdfast/core": "workspace:*",
    "@holdfast/db": "workspace:*",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "fastify": "^5.12.5",
    "pino": "^10.1.0"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "bn.js": "^5.2.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
