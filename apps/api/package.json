{
  "name": "@holdfast/api",
  "version": "0.1.0",
  "private": true,
  "description": "Holdfast REST + WebSocket API (docs/api.md).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "dev:pglite": "tsx src/dev/pglite.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "@holdfast/chain": "workspace:*",
    "@holdfast/core": "workspace:*",
    "@holdfast/db": "workspace:*",
    "@pump-fun/pump-sdk": "4.1.0",
    "@pump-fun/pump-swap-sdk": "2.1.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "bn.js": "^5.2.2",
    "fastify": "^5.12.5",
    "pino": "^10.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "ws": "^8.18.3"
  }
}
