{
  "name": "holdfast",
  "private": true,
  "version": "0.1.0",
  "description": "Holdfast: pump.fun launchpad where creator fees fund a floor vault and pay long-term holders.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' --filter './apps/*' run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r --if-present run test",
    "lint": "pnpm -r --if-present run lint",
    "program:build": "anchor build",
    "program:test": "cargo test -p holdfast-vault-tests -- --test-threads=4",
    "db:migrate": "pnpm --filter @holdfast/db run migrate"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
