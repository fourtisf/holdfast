# ---- shared -------------------------------------------------------------
# Postgres connection used by indexer, keeper, payout, launcher and api.
DATABASE_URL=postgres://holdfast:holdfast@localhost:5432/holdfast
# Solana RPC (HTTP + WS). Use a Helius/Triton/QuickNode endpoint in production.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com
# Cluster label used for explorer links and safety checks: devnet | mainnet-beta | localnet
SOLANA_CLUSTER=devnet
# Holdfast vault program id (see Anchor.toml / target/deploy).
HOLDFAST_PROGRAM_ID=8WhCTXTNjZi1fJn5uK6E4cRiGJtKt3RUsnJjCWf5ytdM

# ---- keeper / payout -----------------------------------------------------
# Path to the keeper authority keypair (JSON array). Must match Config.keeper on-chain.
KEEPER_KEYPAIR=./keys/keeper.json
# Optional Jito block engine for bundling defend/burn transactions.
JITO_BLOCK_ENGINE_URL=
# Crank cadence and safety margins (defaults shown).
KEEPER_TICK_MS=30000
KEEPER_COIN_CONCURRENCY=8
KEEPER_COLLECT_EVERY_SECS=120
KEEPER_DEFEND_SLIPPAGE_BPS=300
KEEPER_CURVE_FEE_BPS_ESTIMATE=200
KEEPER_AMM_FEE_BPS_ESTIMATE=100
KEEPER_DEFEND_JITTER_MS=4000
KEEPER_BURN_THRESHOLD_LAMPORTS=100000000
KEEPER_BURN_SLIPPAGE_BPS=400
KEEPER_BURN_EVERY_SECS=3600
KEEPER_PRIORITY_MICROLAMPORTS=50000
# Payout worker (runs every 2 minutes on the wall clock).
PAYOUT_MIN_SOL_LAMPORTS=20000
PAYOUT_MIN_TOKENS_RAW=1000
PAYOUT_CARRY_EXPIRY_MS=2592000000
PAYOUT_MAX_RECIPIENTS=1024
PAYOUT_COIN_CONCURRENCY=4
PAYOUT_COLLECT_BEFORE_ROUND=true
# Lot reduction order for sells/transfers out: fifo (spec default, pending owner confirmation) or lifo.
LOT_REDUCTION_ORDER=fifo

# ---- launcher -------------------------------------------------------------
# Hot wallet that pays for coin creation and holds no user funds long-term.
LAUNCHER_KEYPAIR=./keys/launcher.json
# 32-byte hex secret used to derive per-launch deposit keypairs (HKDF). Keep offline backups.
DEPOSIT_MASTER_SECRET=
# Local directory for uploaded images (+ metadata JSON with METADATA_STORAGE=local), shared by the API
# and the launcher. Use an absolute path when the services run from their package directories.
METADATA_STORE=./data/metadata
PUBLIC_METADATA_BASE_URL=http://localhost:4000/metadata
# Where pump.fun metadata lives: local (served by our API; development only, it dies with the server)
# or pinata (image + JSON pinned to IPFS; URIs point at IPFS_GATEWAY_URL). Production: pinata.
METADATA_STORAGE=local
PINATA_JWT=
IPFS_GATEWAY_URL=https://ipfs.io
# Site URL written into pump.fun metadata (`createdOn`); defaults to the metadata base's origin.
PUBLIC_SITE_URL=http://localhost:3000
# Address lookup table for atomic (anti-snipe) launches: create + init + dev buy in ONE transaction.
# Create it with `pnpm --filter @holdfast/launcher alt create`; empty = the four-transaction flow.
LAUNCHER_LOOKUP_TABLE=
# Rejected atomic attempts before a launch falls back to the four-transaction flow.
LAUNCHER_ATOMIC_ATTEMPTS=2
# The API reads METADATA_STORAGE, IPFS_GATEWAY_URL, LAUNCHER_LOOKUP_TABLE and these three as well, so its
# launch quotes match what the launcher charges.
LAUNCHER_PRIORITY_FEE_MICROLAMPORTS=50000
LAUNCHER_DEV_BUY_SLIPPAGE_BPS=500
LAUNCHER_CLOSE_DEPOSIT_ACCUMULATOR=true
LAUNCHER_MAX_ATTEMPTS=6
LAUNCHER_POLL_INTERVAL_MS=3000

# ---- indexer --------------------------------------------------------------
# Helius *raw* webhook auth header (enhanced payloads carry no logs, so vault events would be missed).
HELIUS_WEBHOOK_SECRET=
INDEXER_PORT=4100
# Poll getSignaturesForAddress for the program + every coin's mint, curve and pool.
INDEXER_POLL=true
INDEXER_POLL_INTERVAL_MS=4000
INDEXER_MAX_TX_VERSION=0
# Launcher hot wallet: a normal wallet, so it must be excluded from payouts explicitly.
LAUNCHER_ADDRESS=

# ---- api ------------------------------------------------------------------
API_PORT=4000
CORS_ORIGIN=http://localhost:3000
API_RATE_LIMIT_PER_MINUTE=600
# Compute budget for user trade transactions built by /trade/build.
TRADE_CU_PRICE_MICROLAMPORTS=100000
TRADE_CU_LIMIT_CURVE=250000
TRADE_CU_LIMIT_AMM=300000
# How long a launch deposit address stays valid.
LAUNCH_TTL_MS=900000

# ---- local development ------------------------------------------------------
LOG_LEVEL=info
# `pnpm --filter @holdfast/api dev:pglite`: persist the embedded database here (in-memory when unset).
PGLITE_DIR=
# Simulated trades in dev:pglite (0 to disable).
DEV_SIMULATE=1

# ---- web ------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
