# ---- shared -------------------------------------------------------------
# Postgres connection used by indexer, keeper, payout, launcher, notifier and api.
DATABASE_URL=postgres://holdfast:holdfast@localhost:5432/holdfast
# Solana RPC (HTTP + WS). Use a Helius/Triton/QuickNode endpoint in production.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com
# Cluster label used for explorer links and safety checks: devnet | mainnet-beta | localnet
SOLANA_CLUSTER=devnet
# Moatpad vault program id (see Anchor.toml / target/deploy).
HOLDFAST_PROGRAM_ID=8pVgMgwxbhPuKLwsP7z9sa6ADs7L3KWYAbhBGnrtgSmN

# ---- keeper / payout -----------------------------------------------------
# Path to the keeper authority keypair (JSON array). Must match Config.keeper on-chain.
KEEPER_KEYPAIR=./keys/keeper.json
# Optional Jito block engine for bundling defend/burn transactions.
JITO_BLOCK_ENGINE_URL=
# Crank cadence and safety margins (defaults shown). Fees are collected only after a coin trades, at most every
# KEEPER_COLLECT_EVERY_SECS; the TWAP is sampled only while the price is above the ATH (decisions #29).
KEEPER_TICK_MS=30000
KEEPER_COIN_CONCURRENCY=8
KEEPER_COLLECT_EVERY_SECS=600
KEEPER_DEFEND_SLIPPAGE_BPS=300
KEEPER_CURVE_FEE_BPS_ESTIMATE=200
KEEPER_AMM_FEE_BPS_ESTIMATE=100
KEEPER_DEFEND_JITTER_MS=4000
KEEPER_BURN_THRESHOLD_LAMPORTS=100000000
KEEPER_BURN_SLIPPAGE_BPS=400
KEEPER_BURN_EVERY_SECS=3600
# The platform's 10% share is swept to the platform treasury (set on-chain with `admin set-platform-treasury`)
# once a coin's bucket holds this many lamports, at most every N seconds per coin.
KEEPER_PLATFORM_SWEEP_LAMPORTS=10000000
KEEPER_PLATFORM_SWEEP_EVERY_SECS=3600
# Buybacks pay the full priority fee; every other keeper transaction is not time critical.
KEEPER_PRIORITY_MICROLAMPORTS=50000
KEEPER_ROUTINE_PRIORITY_MICROLAMPORTS=10000
# With the keeper as platform treasury (`bash deploy/program.sh revenue <wallet>`), the 10% share pays for the
# keeper's transactions and whatever exceeds the reserve is forwarded to KEEPER_PROFIT_WALLET.
KEEPER_PROFIT_WALLET=
KEEPER_RESERVE_LAMPORTS=300000000
# Payout worker (runs every 2 minutes on the wall clock).
PAYOUT_MIN_SOL_LAMPORTS=20000
PAYOUT_MIN_TOKENS_RAW=1000
PAYOUT_CARRY_EXPIRY_MS=2592000000
PAYOUT_MAX_RECIPIENTS=1024
PAYOUT_COIN_CONCURRENCY=4
# Payout transactions are not time critical: cheap priority fee.
PAYOUT_PRIORITY_MICROLAMPORTS=1000
# A round whose fees exceed this share (bps) of what it pays waits for a bigger pot; per-recipient
# minimums are raised to the same ratio. 200 = 2%.
PAYOUT_MAX_FEE_BPS=200
# No new round below this keeper balance (lamports); the keeper refills from the platform share (decisions #30).
KEEPER_MIN_BALANCE_LAMPORTS=5000000
# Lot reduction order for sells/transfers out: fifo (spec default, pending owner confirmation) or lifo.
LOT_REDUCTION_ORDER=fifo

# ---- launcher -------------------------------------------------------------
# Hot wallet that pays for coin creation and holds no user funds long-term.
LAUNCHER_KEYPAIR=./keys/launcher.json
# 32-byte hex secret used to derive per-launch deposit keypairs (HKDF). Keep offline backups.
DEPOSIT_MASTER_SECRET=
# Local directory for uploaded images (+ metadata JSON with METADATA_STORAGE=local), shared by the API
# and the launcher. Use an absolute path when the services run from their package directories.
METADATA_STORE=./data/metadata
PUBLIC_METADATA_BASE_URL=http://localhost:4000/metadata
# Where pump.fun metadata lives: local (served by our API; development only, it dies with the server)
# or pinata (image + JSON pinned to IPFS; URIs point at IPFS_GATEWAY_URL). Production: pinata.
METADATA_STORAGE=local
PINATA_JWT=
IPFS_GATEWAY_URL=https://ipfs.io
# Site URL written into pump.fun metadata (`createdOn`); defaults to the metadata base's origin.
PUBLIC_SITE_URL=http://localhost:3000
# Address lookup table for atomic (anti-snipe) launches: create + init + dev buy in ONE transaction.
# Create it with `pnpm --filter @holdfast/launcher alt create`; empty = the four-transaction flow.
LAUNCHER_LOOKUP_TABLE=
# Rejected atomic attempts before a launch falls back to the four-transaction flow.
LAUNCHER_ATOMIC_ATTEMPTS=2
# The API reads METADATA_STORAGE, IPFS_GATEWAY_URL, LAUNCHER_LOOKUP_TABLE and these three as well, so its
# launch quotes match what the launcher charges.
LAUNCHER_PRIORITY_FEE_MICROLAMPORTS=50000
# Compute-unit price of launches signed in the creator's wallet (they pay it; ≈ 0.00025-0.00045 SOL at 1,000,000).
LAUNCHER_WALLET_PRIORITY_MICROLAMPORTS=1000000
LAUNCHER_DEV_BUY_SLIPPAGE_BPS=500
LAUNCHER_CLOSE_DEPOSIT_ACCUMULATOR=true
LAUNCHER_MAX_ATTEMPTS=6
LAUNCHER_POLL_INTERVAL_MS=3000

# ---- monitoring -----------------------------------------------------------
# Every service exposes Prometheus metrics at /metrics and liveness at /healthz: the api on its port,
# the indexer on INDEXER_PORT, and these ops ports for the services without an HTTP server ("0" = off;
# the notifier's NOTIFIER_OPS_PORT=9104 is in its own section below).
KEEPER_OPS_PORT=9101
PAYOUT_OPS_PORT=9102
LAUNCHER_OPS_PORT=9103
# Where the API reaches the launcher's ops port, which builds wallet-signed launch transactions (POST
# /wallet-launch). Keep that port internal; compose sets this to http://launcher:9103.
LAUNCHER_INTERNAL_URL=http://localhost:9103
# Operator alerts (keeper balance, creator fees diverted by a pump.fun admin, failing cranks/rounds,
# stuck/failed launches): Telegram bot and/or a Slack/Discord-compatible webhook.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=
# The same alert is re-sent at most this often while it keeps firing.
ALERT_MIN_INTERVAL_MS=900000

# ---- moderation / admin ---------------------------------------------------
# Bearer token for /admin/* and the web /admin page (≥ 24 characters; empty disables the admin API).
ADMIN_TOKEN=
# Extra blocked terms for launch text (one per line, # comments), on top of the built-in list. Read by API and launcher.
MODERATION_BLOCKLIST_FILE=
# Optional image classifier: POST <image bytes> → {"flagged": true|false}. Fail-open unless FAIL_CLOSED=true.
MODERATION_IMAGE_WEBHOOK_URL=
MODERATION_IMAGE_FAIL_CLOSED=false
# Hide a coin automatically after this many distinct reports, pending review (0 = never; sybil-prone).
MODERATION_AUTO_HIDE_REPORTS=0
# Salt for hashing reporter IPs (defaults to DEPOSIT_MASTER_SECRET).
REPORT_SALT=

# ---- indexer --------------------------------------------------------------
# Helius *raw* webhook auth header (enhanced payloads carry no logs, so vault events would be missed).
HELIUS_WEBHOOK_SECRET=
INDEXER_PORT=4100
# Poll getSignaturesForAddress for the program + every coin's mint, curve and pool.
INDEXER_POLL=true
INDEXER_POLL_INTERVAL_MS=4000
INDEXER_MAX_TX_VERSION=0
# Live ingestion: a logsSubscribe per coin mint (+ the program) on SOLANA_WS_URL, so trades reach the chart
# about 1-2 s after they confirm instead of at the next poll. The poller keeps backing it up. A SOLANA_WS_URL
# on another host than SOLANA_RPC_URL is ignored (with a warning) in favour of the RPC host's WebSocket.
INDEXER_LIVE=true
# Addresses the poller lists at the same time (each one RPC call); raise it only if the RPC plan allows.
INDEXER_POLL_CONCURRENCY=2
# Abort RPC requests after this long (a hung request must not stall ingestion).
INDEXER_RPC_TIMEOUT_MS=20000
# Launcher hot wallet: a normal wallet, so it must be excluded from payouts explicitly.
LAUNCHER_ADDRESS=

# ---- api ------------------------------------------------------------------
API_PORT=4000
CORS_ORIGIN=http://localhost:3000
API_RATE_LIMIT_PER_MINUTE=600
# Compute budget for user trade transactions built by /trade/build.
TRADE_CU_PRICE_MICROLAMPORTS=100000
TRADE_CU_LIMIT_CURVE=250000
TRADE_CU_LIMIT_AMM=300000
# SOL/USD for the UI's USD toggle (display only): Pyth Hermes, then CoinGecko. PRICE_FEED=off disables it,
# COINGECKO_PRICE_URL=off skips the fallback.
PRICE_FEED=on
PYTH_HERMES_URL=https://hermes.pyth.network
COINGECKO_PRICE_URL=
# How long a launch deposit address stays valid.
LAUNCH_TTL_MS=900000
# Refuse new launches (no deposit addresses; the web form shows "Launches open soon") until the launcher
# runs on this cluster. deploy/init.sh sets it to true.
LAUNCHES_PAUSED=false

# ---- telegram bot (apps/notifier): /launch, group buy bot, alerts, $MOATPAD burns --------------------
# Bot token from @BotFather, required by the notifier. Only one process may poll a bot, so run one notifier per
# token. Use a different bot from ALERT_TELEGRAM_BOT_TOKEN: this one is public, operator alerts are not.
# The bot only runs with the "telegram" compose profile: COMPOSE_PROFILES=telegram.
TELEGRAM_BOT_TOKEN=
# The bot's username (without @), for the website's "Launch on Telegram" / "Buy bot" / "Alerts" links.
NEXT_PUBLIC_TELEGRAM_BOT=
# Channel or group that gets every $MOATPAD buy & burn (add the bot as an admin there first), e.g. -1001234567890.
NOTIFIER_BURN_CHAT_ID=
# Public web app origin used in coin links (`<WEB_URL>/coin/<mint>`). Falls back to PUBLIC_SITE_URL.
WEB_URL=http://localhost:3000
# Solscan links use SOLANA_CLUSTER (above); the notifier defaults to mainnet-beta when it is unset.
# /healthz (fresh while the getUpdates loop is alive) and /metrics; "0" disables.
NOTIFIER_OPS_PORT=9104
# How often watched wallets' open lots are checked for the 0.5x / full-weight milestones.
NOTIFIER_MILESTONE_INTERVAL_MS=600000
# getUpdates long-poll timeout (seconds).
NOTIFIER_POLL_TIMEOUT_SECS=30
# On startup, re-check rounds, floor defences and graduations of this window (missed while it was down).
NOTIFIER_CATCHUP_MS=900000
# The notifier applies pending migrations at startup unless this is 0.
NOTIFIER_MIGRATE=1
# Optional: a self-hosted Bot API server instead of https://api.telegram.org.
TELEGRAM_API_URL=

# ---- local development ------------------------------------------------------
LOG_LEVEL=info
# `pnpm --filter @holdfast/api dev:pglite`: persist the embedded database here (in-memory when unset).
PGLITE_DIR=
# Simulated trades in dev:pglite (0 to disable).
DEV_SIMULATE=1

# ---- web ------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
# Empty: derived from NEXT_PUBLIC_API_URL (https://site/api -> wss://site/api/ws).
NEXT_PUBLIC_WS_URL=
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# Public site URL: absolute links in share cards (Open Graph images). Production: https://moatpad.fun
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Official X account (nav, announcement bar, sidebar). Defaults to https://x.com/moatpad.
NEXT_PUBLIC_X_URL=
# Official Telegram channel (nav, announcement bar, sidebar). Defaults to https://t.me/MOATPAD.
NEXT_PUBLIC_TELEGRAM_URL=
# $MOATPAD contract address for the announcement bar; empty uses the official one
# (4qLdhoVDiAkXVXqU4D3rSPp6pMMnJzRJr38do55Hpump). Rebuild web after changing it.
NEXT_PUBLIC_MOAT_CA=
# Server-side only (runtime): how the web server reaches the API for link previews. Defaults to NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=
